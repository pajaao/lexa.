021-03:00","url_final":"https://www2.camara.leg.br/legin/fed/emecon/2013/emendaconstitucional-76-28-novembro-2013-777475-publicacaooriginal-142037-pl.html","content_type":"text/html; charset=UTF-8","tamanho_bytes":54015,"sha256":"0a70470908de8c9b1cc844bff0998fc570837eb22fcb71d0d7515ae0cb5d26af","codificacao_identificada":{"encoding":"utf-8","criterio":"HTTP","declaracao_meta":"utf-8","tentativas_invalidas":[]}},"technicalStatus":"VALIDADA TECNICAMENTE COM RESSALVA DOCUMENTAL","caveats":["1 ocorrência(s) documental(is) entre fontes preservada(s); assinatura, fecho, metadados ou apresentação não condicionam a igualdade do corpo normativo à outra fonte."],"review":{"status":"pending","publicationAuthorized":false},"preamble":{"text":"\r\n\t\t\t\t\t\t\t     As Mesas da Câmara dos Deputados e do Senado Federal, nos termos do § 3º do art. 60 da Constituição Federal, promulgam a seguinte Emenda ao texto constitucional: ","runs":[{"text":"\r\n\t\t\t\t\t\t\t     As Mesas da Câmara dos Deputados e do Senado Federal, nos termos do § 3º do art. 60 da Constituição Federal, promulgam a seguinte Emenda ao texto constitucional: ","deleted":false}],"source":{"line":534,"offset":30854}},"ementas":[{"text":"\r\n\t\t\t\t\t\t\tAltera o § 2º do art. 55 e o § 4º do art. 66 da Constituição Federal, para abolir a votação secreta nos casos de perda de mandato de Deputado ou Senador e de apreciação de veto. \r\n\t\t\t\t\t\t","runs":[{"text":"\r\n\t\t\t\t\t\t\tAltera o § 2º do art. 55 e o § 4º do art. 66 da Constituição Federal, para abolir a votação secreta nos casos de perda de mandato de Deputado ou Senador e de apreciação de veto. \r\n\t\t\t\t\t\t","deleted":false}],"source":{"line":530,"offset":30622}}],"blocks":[{"id":2,"text":"     Art. 1º Os arts. 55 e 66 da Constituição Federal passam a vigorar com as seguintes alterações: ","runs":[{"text":"     Art. 1º Os arts. 55 e 66 da Constituição Federal passam a vigorar com as seguintes alterações: ","deleted":false}],"kind":"artigo_proprio","ownArticle":"1","citedArticle":null,"unit":null,"source":{"line":535,"offset":31058}},{"id":3,"text":"\"Art. 55. ................................................................................... ","runs":[{"text":"\"Art. 55. ................................................................................... ","deleted":false}],"kind":"artigo_citado","ownArticle":"1","citedArticle":"55","unit":null,"source":{"line":536,"offset":31203}},{"id":4,"text":".................................................................................................. ","runs":[{"text":".................................................................................................. ","deleted":false}],"kind":"dispositivo_citado","ownArticle":"1","citedArticle":"55","unit":null,"source":{"line":536,"offset":31306}},{"id":5,"text":"§ 2º Nos casos dos incisos I, II e VI, a perda do mandato será decidida pela Câmara dos Deputados ou pelo Senado Federal, por maioria absoluta, mediante provocação da respectiva Mesa ou de partido político representado no Congresso Nacional, assegurada ampla defesa. ","runs":[{"text":"§ 2º Nos casos dos incisos I, II e VI, a perda do mandato será decidida pela Câmara dos Deputados ou pelo Senado Federal, por maioria absoluta, mediante provocação da respectiva Mesa ou de partido político representado no Congresso Nacional, assegurada ampla defesa. ","deleted":false}],"kind":"dispositivo_citado","ownArticle":"1","citedArticle":"55","unit":{"tipo":"paragrafo","marcador_literal":"§ 2º","prefixo_citacao_literal":"","inicio_no_texto_de_comparacao":0,"fim_no_texto_de_comparacao":4},"source":{"line":536,"offset":31413}},{"id":6,"text":"..............................................................................................\" (NR)","runs":[{"text":"..............................................................................................\" (NR)","deleted":false}],"kind":"dispositivo_citado","ownArticle":"1","citedArticle":"55","unit":null,"source":{"line":536,"offset":31684}},{"id":7,"text":"\"Art. 66. ................................................................................... ","runs":[{"text":"\"Art. 66. ................................................................................... ","deleted":false}],"kind":"artigo_citado","ownArticle":"1","citedArticle":"66","unit":null,"source":{"line":537,"offset":31797}},{"id":8,"text":".................................................................................................... ","runs":[{"text":".................................................................................................... ","deleted":false}],"kind":"dispositivo_citado","ownArticle":"1","citedArticle":"66","unit":null,"source":{"line":537,"offset":31900}},{"id":9,"text":"§ 4º O veto será apreciado em sessão conjunta, dentro de trinta dias a contar de seu recebimento, só podendo ser rejeitado pelo voto da maioria absoluta dos Deputados e Senadores. ","runs":[{"text":"§ 4º O veto será apreciado em sessão conjunta, dentro de trinta dias a contar de seu recebimento, só podendo ser rejeitado pelo voto da maioria absoluta dos Deputados e Senadores. ","deleted":false}],"kind":"dispositivo_citado","ownArticle":"1","citedArticle":"66","unit":{"tipo":"paragrafo","marcador_literal":"§ 4º","prefixo_citacao_literal":"","inicio_no_texto_de_comparacao":0,"fim_no_texto_de_comparacao":4},"source":{"line":537,"offset":32009}},{"id":10,"text":"...............................................................................................\" (NR)","runs":[{"text":"...............................................................................................\" (NR)","deleted":false}],"kind":"dispositivo_citado","ownArticle":"1","citedArticle":"66","unit":null,"source":{"line":537,"offset":32193}},{"id":11,"text":"     Art. 2º Esta Emenda Constitucional entra em vigor na data de sua publicação. ","runs":[{"text":"     Art. 2º Esta Emenda Constitucional entra em vigor na data de sua publicação. ","deleted":false}],"kind":"artigo_proprio","ownArticle":"2","citedArticle":null,"unit":null,"source":{"line":538,"offset":32309}}],"closing":[{"text":"     Brasília, em 28 de novembro de 2013 ","runs":[{"text":"     Brasília, em 28 de novembro de 2013 ","deleted":false}],"source":{"line":539,"offset":32430}},{"text":"Mesa da Câmara dos Deputados","runs":[{"text":"Mesa da Câmara dos Deputados","deleted":false}],"source":{"line":545,"offset":33301}},{"text":"Mesa do Senado Federal","runs":[{"text":"Mesa do Senado Federal","deleted":false}],"source":{"line":547,"offset":34039}},{"text":"Deputado HENRIQUE EDUARDO ALVES","runs":[{"text":"Deputado HENRIQUE EDUARDO ALVES","deleted":false}],"source":{"line":550,"offset":34665}},{"text":"Presidente","runs":[{"text":"Presidente","deleted":false}],"source":{"line":550,"offset":34700}},{"text":"Senador RENAN CALHEIROS","runs":[{"text":"Senador RENAN CALHEIROS","deleted":false}],"source":{"line":552,"offset":35347}},{"text":"Presidente","runs":[{"text":"Presidente","deleted":false}],"source":{"line":553,"offset":35554}},{"text":"Deputado MARCIO BITTAR","runs":[{"text":"Deputado MARCIO BITTAR","deleted":false}],"source":{"line":556,"offset":36164}},{"text":"1º Secretário","runs":[{"text":"1º Secretário","deleted":false}],"source":{"line":557,"offset":36370}},{"text":"Senador JORGE VIANA","runs":[{"text":"Senador JORGE VIANA","deleted":false}],"source":{"line":559,"offset":37039}},{"text":"1º Vice-Presidente","runs":[{"text":"1º Vice-Presidente","deleted":false}],"source":{"line":560,"offset":37242}},{"text":"Deputado SIMÃO SESSIM","runs":[{"text":"Deputado SIMÃO SESSIM","deleted":false}],"source":{"line":563,"offset":37860}},{"text":"2º Secretário","runs":[{"text":"2º Secretário","deleted":false}],"source":{"line":564,"offset":38065}},{"text":"Senador FLEXA RIBEIRO","runs":[{"text":"Senador FLEXA RIBEIRO","deleted":false}],"source":{"line":566,"offset":38734}},{"text":"1º Secretário","runs":[{"text":"1º Secretário","deleted":false}],"sourc