.................................................................................... ","deleted":false}],"kind":"dispositivo_citado","ownArticle":"3","citedArticle":"144","unit":null,"source":{"line":538,"offset":32923}},{"id":16,"text":"§ 5º-A. Às polícias penais, vinculadas ao órgão administrador do sistema penal da unidade federativa a que pertencem, cabe a segurança dos estabelecimentos penais. ","runs":[{"text":"§ 5º-A. Às polícias penais, vinculadas ao órgão administrador do sistema penal da unidade federativa a que pertencem, cabe a segurança dos estabelecimentos penais. ","deleted":false}],"kind":"dispositivo_citado","ownArticle":"3","citedArticle":"144","unit":{"tipo":"paragrafo","marcador_literal":"§ 5º-A","prefixo_citacao_literal":"","inicio_no_texto_de_comparacao":0,"fim_no_texto_de_comparacao":6},"source":{"line":538,"offset":33065}},{"id":17,"text":"§ 6º As polícias militares e os corpos de bombeiros militares, forças auxiliares e reserva do Exército subordinam-se, juntamente com as polícias civis e as polícias penais estaduais e distrital, aos Governadores dos Estados, do Distrito Federal e dos Territórios.","runs":[{"text":"§ 6º As polícias militares e os corpos de bombeiros militares, forças auxiliares e reserva do Exército subordinam-se, juntamente com as polícias civis e as polícias penais estaduais e distrital, aos Governadores dos Estados, do Distrito Federal e dos Territórios.","deleted":false}],"kind":"dispositivo_citado","ownArticle":"3","citedArticle":"144","unit":{"tipo":"paragrafo","marcador_literal":"§ 6º","prefixo_citacao_literal":"","inicio_no_texto_de_comparacao":0,"fim_no_texto_de_comparacao":4},"source":{"line":538,"offset":33237}},{"id":18,"text":"................................................................................................................................\" (NR)","runs":[{"text":"................................................................................................................................\" (NR)"