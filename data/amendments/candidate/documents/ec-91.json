ara.leg.br/legin/fed/emecon/2016/emendaconstitucional-91-18-fevereiro-2016-782395-publicacaooriginal-149499-pl.html","content_type":"text/html; charset=UTF-8","tamanho_bytes":52416,"sha256":"63afdfc6e8d5e3dbb725e3651524333b4dd0eab5e1426e724d0c972e8a8287c3","codificacao_identificada":{"encoding":"utf-8","criterio":"HTTP","declaracao_meta":"utf-8","tentativas_invalidas":[]}},"technicalStatus":"VALIDADA TECNICAMENTE","caveats":[],"review":{"status":"pending","publicationAuthorized":false},"preamble":{"text":"     As Mesas da Câmara dos Deputados e do Senado Federal, nos termos do § 3º do art. 60 da Constituição Federal, promulgam a seguinte Emenda ao texto constitucional: ","runs":[{"text":"     As Mesas da Câmara dos Deputados e do Senado Federal, nos termos do § 3º do art. 60 da Constituição Federal, promulgam a seguinte Emenda ao texto constitucional: ","deleted":false}],"source":{"line":535,"offset":30818}},"ementas":[{"text":"\r\n\t\t\t\t\t\t\tAltera a Constituição Federal para estabelecer a possibilidade, excepcional e em período determinado, de desfiliação partidária, sem prejuízo do mandato.\r\n\t\t\t\t\t\t","runs":[{"text":"\r\n\t\t\t\t\t\t\tAltera a Constituição Federal para estabelecer a possibilidade, excepcional e em período determinado, de desfiliação partidária, sem prejuízo do mandato.\r\n\t\t\t\t\t\t","deleted":false}],"source":{"line":530,"offset":30599}}],"blocks":[{"id":2,"text":"     Art. 1º É facultado ao detentor de mandato eletivo desligar-se do partido pelo qual foi eleito nos trinta dias seguintes à promulgação desta Emenda Constitucional, sem prejuízo do mandato, não sendo essa desfiliação considerada para fins de distribuição dos recursos do Fundo Partidário e de acesso gratuito ao tempo de rádio e televisão. ","runs":[{"text":"     Art. 1º É facultado ao detentor de mandato eletivo desligar-se do partido pelo qual foi eleito nos trinta dias seguintes à promulgação desta Emenda Constitucional, sem prejuízo do mandato, não sendo essa desfiliação considerada para fins de distribuição dos recursos do Fundo Partidário e de acesso gratuito ao tempo de rádio e televisão. ","deleted":false}],"kind":"artigo_proprio","ownArticle":"1","citedArticle":null,"unit":null,"source":{"line":535,"offset":31013}},{"id":3,"text":"     Art. 2º Esta Emenda Constitucional entra em vigor na data de sua publicação. ","runs":[{"text":"     Art. 2º Esta Emenda Constitucional entra em vigor na data de sua publicação. ","deleted":false}],"kind":"artigo_proprio","ownArticle":"2","citedArticle":null,"unit":null,"source":{"line":535,"offset":31395}}],"closing":[{"text":"     Brasília, em 18 de fevereiro de 2016.  ","runs":[{"text":"     Brasília, em 18 de fevereiro de 2016.  ","deleted":false}],"source":{"line":536,"offset":31516}},{"text":"Mesa da Câmara dos Deputados","runs":[{"text":"Mesa da Câmara dos Deputados","deleted":false}],"source":{"line":542,"offset":32368}},{"text":"Mesa do Senado Federal","runs":[{"text":"Mesa do Senado Federal","deleted":false}],"source":{"line":544,"offset":32968}},{"text":"Deputado EDUARDO CUNHA","runs":[{"text":"Deputado EDUARDO CUNHA","deleted":false}],"source":{"line":548,"offset":33655}},{"text":"Presidente","runs":[{"text":"Presidente","deleted":false}],"source":{"line":549,"offset":33834}},{"text":"Senador RENAN CALHEIROS","runs":[{"text":"Senador RENAN CALHEIROS","deleted":false}],"source":{"line":551,"offset":34398}},{"text":"Presidente","runs":[{"text":"Presidente","deleted":false}],"source":{"line":552,"offset":34578}},{"text":"Deputado WALDIR MARANHÃO","runs":[{"text":"Deputado WALDIR MARANHÃO","deleted":false}],"source":{"line":555,"offset":35086}},{"text":"1º Vice-Presidente","runs":[{"text":"1º Vice-Presidente","deleted":false}],"source":{"line":556,"offset":35267}},{"text":"Senador JORGE VIANA","runs":[{"text":"Senador JORGE VIANA","deleted":false}],"source":{"line":558,"offset":35839}},{"text":"1º Vice-Presidente","runs":[{"text":"1º Vice-Presidente","deleted":false}],"source":{"line"