796285-publicacaooriginal-173094-pl.html","content_type":"text/html; charset=UTF-8","tamanho_bytes":53346,"sha256":"5f4585335e577b11976237966bde3bb179cb1984a62ed4b1582ae9f2f9efcbdc","codificacao_identificada":{"encoding":"utf-8","criterio":"HTTP","declaracao_meta":"utf-8","tentativas_invalidas":[]}},"technicalStatus":"VALIDADA TECNICAMENTE","caveats":[],"review":{"status":"pending","publicationAuthorized":false},"preamble":{"text":"\r\n\t\t\t\t\t\t\t     As Mesas da Câmara dos Deputados e do Senado Federal, nos termos do § 3º do art. 60 da Constituição Federal, promulgam a seguinte Emenda ao texto constitucional: ","runs":[{"text":"\r\n\t\t\t\t\t\t\t     As Mesas da Câmara dos Deputados e do Senado Federal, nos termos do § 3º do art. 60 da Constituição Federal, promulgam a seguinte Emenda ao texto constitucional: ","deleted":false}],"source":{"line":534,"offset":30734}},"ementas":[{"text":"\r\n\t\t\t\t\t\t\tAltera o art. 96 da Constituição Federal, para dispor sobre a eleição dos órgãos diretivos de Tribunais de Justiça.\r\n\t\t\t\t\t\t","runs":[{"text":"\r\n\t\t\t\t\t\t\tAltera o art. 96 da Constituição Federal, para dispor sobre a eleição dos órgãos diretivos de Tribunais de Justiça.\r\n\t\t\t\t\t\t","deleted":false}],"source":{"line":530,"offset":30565}}],"blocks":[{"id":2,"text":"     Art. 1º O art. 96 da Constituição Federal passa a vigorar acrescido do seguinte parágrafo único: ","runs":[{"text":"     Art. 1º O art. 96 da Constituição Federal passa a vigorar acrescido do seguinte parágrafo único: ","deleted":false}],"kind":"artigo_proprio","ownArticle":"1","citedArticle":null,"unit":null,"source":{"line":535,"offset":30938}},{"id":3,"text":"\"Art. 96. ............................................................................................................... ","runs":[{"text":"\"Art. 96. ............................................................................................................... ","deleted":false}],"kind":"artigo_citado","ownArticle":"1","citedArticle":"96","unit":null,"source":{"line":536,"offset":31085}},{"id":4,"text":".............................................................................................................................. ","runs":[{"text":".............................................................................................................................. ","deleted":false}],"kind":"dispositivo_citado","ownArticle":"1","citedArticle":"96","unit":null,"source":{"line":536,"offset":31216}},{"id":5,"text":"Parágrafo único. Nos Tribunais de Justiça compostos de mais de 170 (cento e setenta) desembargadores em efetivo exercício, a eleição para os cargos diretivos, de que trata a alínea \"a\" do inciso I do caput deste artigo, será realizada entre os membros do tribunal pleno, por maioria absoluta e por voto direto e secreto, para um mandato de 2 (dois) anos, vedada mais de 1 (uma) recondução sucessiva.\" (NR)","runs":[{"text":"Parágrafo único. ","deleted":false},{"text":"Nos Tribunais de Justiça compostos de mais de 170 (cento e setenta) desembargadores em efetivo exercício, a eleição para os cargos diretivos, de que trata a alínea \"a\" do inciso I do ","deleted":false},{"text":"caput","deleted":false},{"text":" deste artigo, será realizada entre os membros do tribunal pleno, por maioria absoluta e por voto direto e secreto, para um mandato de 2 (dois) anos, vedada mais de 1 (uma) recondução sucessiva.\" (NR)","deleted":false}],"kind":"dispositivo_citado","ownArticle":"1","citedArticle":"96","unit":{"tipo":"paragrafo_unico","marcador_literal":"Parágrafo único.","prefixo_citacao_literal":"","inicio_no_texto_de_comparacao":0,"fim_no_texto_de_comparacao":16},"source":{"line":536,"offset":31354}},{"id":6,"text":"     Art. 2º Esta Emenda Constitucional entra em vigor na data de sua publicação. ","runs":[{"text":"     Art. 2º Esta Emenda Constitucional entra em vigor na data de sua publicação. ","deleted":false}],"kind":"artigo_proprio","ownArticle":"2","citedArticle":null,"