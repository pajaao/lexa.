ente":{"arquivo":"leitura-independente/emc-071.json","sha256":"a3bf483c046f58c12f1a486077ba497a79a30932374b9bc8d6e3281bd0d93f8f","metodo":"Chromium DOM + TreeWalker independente do parser Python; rede e scripts bloqueados; espaços são a única normalização textual permitida.","checagens":{"fonte_camara_oficial_e_publicacao_original":true,"numero_cabecalho_dom_confere":true,"ano_cabecalho_dom_confere":true,"coleta_http_200":true,"hash_original_coleta_dom_extracao":true,"tamanho_original_coleta":true,"duas_leituras_dom_conservam_caracteres":true,"texto_documental_integral_python_dom":true,"texto_normativo_integral_python_dom":true,"blocos_documentais_ordem_e_repeticoes":true,"blocos_normativos_ordem_e_repeticoes":true,"ids_de_blocos_unicos":true,"artigos_proprios_dom_python":true,"sequencia_propria_regular":true,"classes_e_contextos_dom_python":true,"sem_ambiguidade_estrutural_dom":true,"subdivisoes_dom_python":true,"sem_marcas_de_redacao_posterior_na_referencia":true,"limites_normativos_documentados":true},"falhas":[],"cabecalho_dom":"EMENDA CONSTITUCIONAL Nº 71, DE 2012","publicacao_original_dom":[{"texto":"Diário Oficial da União - Seção 1\n                                                         - 30/11/2012, Página 1 \n                                                        \n                                                        (Publicação Original)","html":"<li>\n                                                        \n                                                        Diário Oficial da União - Seção 1\n                                                         - 30/11/2012, Página 1 \n                                                        \n                                                        (Publicação Original)\n                                                        \n                                                    </li>"}],"artigos_proprios_dom":["1","2"],"estrutura_dom":[{"bloco_dom":2,"texto_literal":"     Art. 1º A Constituição Federal passa a vigorar acrescida do seguinte art. 216-A: ","classe":"artigo_proprio","artigo":"1","artigo_proprio_contexto":"1","profundidade":0,"fundamento":["marcador de início no DOM","sem abertura de aspas","recuo compatível com artigos próprios","sequência própria regular"]},{"bloco_dom":3,"texto_literal":"\"Art. 216-A. O Sistema Nacional de Cultura, organizado em regime de colaboração, de forma descentralizada e participativa, institui um processo de gestão e promoção conjunta de políticas públicas de cultura, democráticas e permanentes, pactuadas entre os entes da Federação e a sociedade, tendo por objetivo promover o desenvolvimento humano, social e econômico com pleno exercício dos direitos culturais. ","classe":"artigo_citado","artigo":"216-A","artigo_proprio_contexto":"1","profundidade":1,"fundamento":["abertura de aspas ou recuo de citação"]},{"bloco_dom":4,"texto_literal":"§ 1º O Sistema Nacional de Cultura fundamenta-se na política nacional de cultura e nas suas diretrizes, estabelecidas no Plano Nacional de Cultura, e rege-se pelos seguintes princípios: ","classe":"dispositivo_citado","artigo":null,"artigo_proprio_contexto":"1","profundidade":1,"fundamento":[]},{"bloco_dom":5,"texto_literal":"I - diversidade das expressões culturais; ","classe":"dispositivo_citado","artigo":null,"artigo_proprio_contexto":"1","profundidade":1,"fundamento":[]},{"bloco_dom":6,"texto_literal":"II - universalização do acesso aos bens e serviços culturais; ","classe":"dispositivo_citado","artigo":null,"artigo_proprio_contexto":"1","profundidade":1,"fundamento":[]},{"bloco_dom":7,"texto_literal":"III - fomento à produção, difusão e circulação de conhecimento e bens culturais; ","classe":"dispositivo_citado","artigo":null,"artigo_proprio_contexto":"1","profundidade":1,"fundamento":[]},{"bloco_dom":8,"texto_literal":"IV - cooperação entre os entes federados, os agentes públicos e privados atuantes na área cultural; ","classe":"dispositivo_citado","artigo":null,"artigo_proprio_contexto":"1","profundidade":1,"fundamento":[]},{"bloco_dom":9,"texto_literal":"V - integração e interação na execução das políticas, programas, projetos e ações desenvolvidas; ","classe":"dispositivo_citado","artigo":null,"artigo_proprio_contexto":"1","profundidade":1,"fundamento":[]},{"bloco_dom":10,"texto_literal":"VI - complementaridade nos papéis dos agentes culturais; ","classe":"dispositivo_citado","artigo":null,"artigo_proprio_contexto":"1","profundidade":1,"fundamento":[]},{"bloco_dom":11,"texto_literal":"VII - transversalidade das políticas culturais; ","classe":"dispositivo_citado","artigo":null,"artigo_proprio_contexto":"1","profundidade":1,"fundamento":[]},{"bloco_dom":12,"texto_literal":"VIII - autonomia dos entes federados e das instituições da sociedade civil; ","classe":"dispositivo_citado","artigo":null,"artigo_proprio_contexto":"1","profundidade":1,"fundamento":[]},{"bloco_dom":13,"texto_literal":"IX - transparência e compartilhamento das informações; ","classe":"dispositivo_citado","artigo":null,"artigo_proprio_contexto":"1","profundidade":1,"fundamento":[]},{"bloco_dom":14,"texto_literal":"X - democratização dos processos decisórios com participação e controle social; ","classe":"dispositivo_citado","artigo":null,"artigo_proprio_contexto":"1","profundidade":1,"fundamento":[]},{"bloco_dom":15,"texto_literal":"XI - descentralização articulada e pactuada da gestão, dos recursos e das ações; ","classe":"dispositivo_citado","artigo":null,"artigo_proprio_contexto":"1","profundidade":1,"fundamento":[]},{"bloco_dom":16,"texto_literal":"XII - ampliação progressiva dos recursos contidos nos orçamentos públicos para a cultura. ","classe":"dispositivo_citado","artigo":null,"artigo_proprio_contexto":"1","profundidade":1,"fundamento":[]},{"bloco_dom":17,"texto_literal":"§ 2º Constitui a estrutura do Sistema Nacional de Cultura, nas respectivas esferas da Federação: ","classe":"dispositivo_citado","artigo":null,"artigo_proprio_contexto":"1","profundidade":1,"fundamento":[]},{"bloco_dom":18,"texto_literal":"I - órgãos gestores da cultura; ","classe":"dispositivo_citado","artigo":null,"artigo_proprio_contexto":"1","profundidade":1,"fundamento":[]},{"bloco_dom":19,"texto_literal":"II - conselhos de política cultural; ","classe":"dispositivo_citado","artigo":null,"artigo_proprio_contexto":"1","profundidade":1,"fundamento":[]},{"bloco_dom":20,"texto_literal":"III - conferências de cultura; ","classe":"dispositivo_citado","artigo":null,"artigo_proprio_contexto":"1","profundidade":1,"fundamento":[]},{"bloco_dom":21,"texto_literal":"IV - comissões intergestores; ","classe":"dispositivo_citado","artigo":null,"artigo_proprio_contexto":"1","profundidade":1,"fundamento":[]},{"bloco_dom":22,"texto_literal":"V - planos de cultura; ","classe":"dispositivo_citado","artigo":null,"artigo_proprio_contexto":"1","profundidade":1,"fundamento":[]},{"bloco_dom":23,"texto_literal":"VI - sistemas de financiamento à cultura; ","classe":"dispositivo_citado","artigo":null,"artigo_proprio_contexto":"1","profundidade":1,"fundamento":[]},{"bloco_dom":24,"texto_literal":"VII - sistemas de informações e indicadores culturais; ","classe":"dispositivo_citado","artigo":null,"artigo_proprio_contexto":"1","profundidade":1,"fundamento":[]},{"bloco_dom":25,"texto_literal":"VIII - programas de formação na área da cultura; e ","classe":"dispositivo_citado","artigo":null,"artigo_proprio_contexto":"1","profundidade":1,"fundamento":[]},{"bloco_dom":26,"texto_literal":"IX - sistemas setoriais de cultura. ","classe":"dispositivo_citado","artigo":null,"artigo_proprio_contexto":"1","profundidade":1,"fundamento":[]},{"bloco_dom":27,"texto_literal":"§ 3º Lei federal disporá sobre a regulamentação do Sistema Nacional de Cultura, bem como de sua articulação com os demais sistemas nacionais ou políticas setoriais de governo. ","classe":"dispositivo_citado","artigo":null,"artigo_proprio_contexto":"1","profundidade":1,"fundamento":[]},{"bloco_dom":28,"texto_literal":"§ 4º Os Estados, o Distrito Federal e os Municípios organizarão seus respectivos sistemas de cultura em leis próprias.\"","classe":"dispositivo_citado","artigo":null,"artigo_proprio_contexto":"1","profundidade":1,"fundamento":[]},{"bloco_dom":29,"texto_literal":"     Art. 2º Esta Emenda Constitucional entra em vigor na data de sua publicação. ","classe":"artigo_proprio","artigo":"2","artigo_proprio_contexto":"2","profundidade":0,"fundamento":["marcador de início no DOM","sem abertura de aspas","recuo compatível com artigos próprios","sequência própria regular"]}],"ambiguidades_dom":[],"confronto_por_bloco":[{"bloco_python":2,"offset_html":30889,"linha_html":535,"bloco_dom":2,"caminhos_dom":[".textoNorma > div:nth-of-type(1)"],"texto_integral_confere":true,"sha256_texto_comparacao":"27d39d4b8929e55bbb792000ca70cbdd351a38954da2469321e5fc8dfe0eb5c0"},{"bloco_python":3,"offset_html":31020,"linha_html":536,"bloco_dom":3,"caminhos_dom":[".textoNorma > div:nth-of-type(1) > dir:nth-of-type(1)"],"texto_integral_confere":true,"sha256_texto_comparacao":"c1bfc2a74694943d074d7a3bf47dfe607adc3f5062a4181fedade68e289d2106"},{"bloco_python":4,"offset_html":31439,"linha_html":536,"bloco_dom":4,"caminhos_dom":[".textoNorma > div:nth-of-type(1) > dir:nth-of-type(1)"],"texto_integral_confere":true,"sha256_texto_comparacao":"2ad3b7f7cd99b09ee35539c832912ffd61525e5addf6a26f904266dc8a2662ed"},{"bloco_python":5,"offset_html":31633,"linha_html":536,"bloco_dom":5,"caminhos_dom":[".textoNorma > div:nth-of-type(1) > dir:nth-of-type(1)"],"texto_integral_confere":true,"sha256_texto_comparacao":"78aa971e77fd4d2bb90c3ced59a2f91ae4987365496ea3596d0d4ca710d5b5a3"},{"bloco_python":6,"offset_html":31683,"linha_html":536,"bloco_dom":6,"caminhos_dom":[".textoNorma > div:nth-of-type(1) > dir:nth-of-type(1)"],"texto_integral_confere":true,"sha256_texto_comparacao":"fc474c001faad6dc98a825f2ac002b1268082659462edd486ab56e51281b685b"},{"bloco_python":7,"offset_html":31753,"linha_html":536,"bloco_dom":7,"caminhos_dom":[".textoNor