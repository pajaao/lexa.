m":[{"bloco_dom":2,"texto_literal":"     Art. 1º O inciso XIV do caput do art. 21 da Constituição Federal passa a vigorar com a seguinte redação: ","classe":"artigo_proprio","artigo":"1","artigo_proprio_contexto":"1","profundidade":0,"fundamento":["marcador de início no DOM","sem abertura de aspas","recuo compatível com artigos próprios","sequência própria regular"]},{"bloco_dom":3,"texto_literal":"\"Art. 21. .................................................................................................................. ","classe":"artigo_citado","artigo":"21","artigo_proprio_contexto":"1","profundidade":1,"fundamento":["abertura de aspas ou recuo de citação"]},{"bloco_dom":4,"texto_literal":".................................................................................................................................. ","classe":"dispositivo_citado","artigo":null,"artigo_proprio_contexto":"1","profundidade":1,"fundamento":[]},{"bloco_dom":5,"texto_literal":"XIV - organizar e manter a polícia civil, a polícia penal, a polícia militar e o corpo de bombeiros militar do Distrito Federal, bem como prestar assistência financeira ao Distrito Federal para a execução de serviços públicos, por meio de fundo próprio; ","classe":"dispositivo_citado","artigo":null,"artigo_proprio_contexto":"1","profundidade":1,"fundamento":[]},{"bloco_dom":6,"texto_literal":".................................................................................................................................\" (NR)","classe":"dispositivo_citado","artigo":null,"artigo_proprio_contexto":"1","profundidade":1,"fundamento":[]},{"bloco_dom":7,"texto_literal":"     Art. 2º O § 4º do art. 32 da Constituição Federal passa a vigorar com a seguinte redação: ","classe":"artigo_proprio","artigo":"2","artigo_proprio_contexto":"2","profundidade":0,"fundamento":["marcador de início no DOM","sem abertura de aspas","recuo compatível com artigos próprios","sequência própria regular"]},{"bloco_dom":8,"texto_literal":"\"Art. 32. ..................................................................................................................","classe":"artigo_citado","artigo":"32","artigo_proprio_contexto":"2","profundidade":1,"fundamento":["abertura de aspas ou recuo de citação"]},{"bloco_dom":9,"texto_literal":"................................................................................................................................... ","classe":"dispositivo_citado","artigo":null,"artigo_proprio_contexto":"2","profundidade":1,"fundamento":[]},{"bloco_dom":10,"texto_literal":"§ 4º Lei federal disporá sobre a utilização, pelo Governo do Distrito Federal, da polícia civil, da polícia penal, da polícia militar e do corpo de bombeiros militar.\" (NR)","classe":"dispositivo_citado","artigo":null,"artigo_proprio_contexto":"2","profundidade":1,"fundamento":[]},{"bloco_dom":11,"texto_literal":"     Art. 3º O art. 144 da Constituição Federal passa a vigorar com as seguintes alterações: ","classe":"artigo_proprio","artigo":"3","artigo_proprio_contexto":"3","profundidade":0,"fundamento":["marcador de início no DOM","sem abertura de aspas","recuo compatível com artigos próprios","sequência própria regular"]},{"bloco_dom":12,"texto_literal":"\"Art. 144. ................................................................................................................ ","classe":"artigo_citado","artigo":"144","artigo_proprio_contexto":"3","profundidade":1,"fundamento":["abertura de aspas ou recuo de citação"]},{"bloco_dom":13,"texto_literal":"................................................................................................................................... ","classe":"dispositivo_citado","artigo":null,"artigo_proprio_contexto":"3","profundidade":1,"fundamento":[]},{"bloco_dom":14,"texto_literal":"VI - polícias penais federal, estaduais e distrital. ","classe":"dispositivo_citado","artigo":null,"artigo_proprio_contexto":"3","profundidade":1,"fundamento":[]},{"bloco_dom":15,"texto_literal":"..................................................................................................................................... ","classe":"dispositivo_citado","artigo":null,"artigo_proprio_contexto":"3","profundidade":1,"fundamento":[]},{"bloco_dom":16,"texto_literal":"§ 5º-A. Às polícias penais, vinculadas ao órgão administrador do sistema penal da unidade federativa a que pertencem, cabe a segurança dos estabelecimentos penais. ","classe":"dispositivo_citado","artigo":null,"artigo_proprio_contexto":"3","profundidade":1,"fundamento":[]},{"bloco_dom":17,"texto_literal":"§ 6º As polícias militares e os corpos de bombeiros militares, forças auxiliares e reserva do Exército subordinam-se, juntamente com as polícias civis e as polícias penais estaduais e distrital, aos Governadores dos Estados, do Distrito Federal e dos Territórios.","classe":"dispositivo_citado","artigo":null,"artigo_proprio_contexto":"3","profundidade":1,"fundamento":[]},{"bloco_dom":18,"texto_literal":"................................................................................................................................\" (NR)","classe":"dispositivo_citado","artigo":null,"artigo_proprio_contexto":"3","profundidade":1,"fundamento":[]},{"bloco_dom":19,"texto_literal":"     Art. 4º O preenchimento do quadro de servidores das polícias penais será feito, exclusivamente, por meio de concurso público e por meio da transformação dos cargos isolados, dos cargos de carreira dos atuais agentes penitenciários e dos cargos públicos equivalentes. ","classe":"artigo_proprio","artigo":"4","artigo_proprio_contexto":"4","profundidade":0,"fundamento":["marcador de início no DOM","sem abertura de aspas","recuo compatível com artigos próprios","sequência própria regular"]},{"bloco_dom":20,"texto_literal":"     Art. 5º Esta Emenda Constitucional entra em vigor na data de sua publicação. ","classe":"artigo_proprio","artigo":"5","artigo_proprio_contexto":"5","profundidade":0,"fundamento":["