        "contextTags": [
          "html",
          "body",
          "div",
          "p"
        ],
        "text": "Art. 1º. O Presidente da República, o Presidente do Supremo Tribunal Federal e os membros do Congresso Nacional prestarão o compromisso de manter, defender e cumprir a Constituição",
        "preceding": [
          {
            "block": 3430,
            "anchors": [],
            "text": "Participantes: Álvaro Dias - Antônio Britto - Bete Mendes - Borges da Silveira - Cardoso Alves - Edivaldo Holanda - Expedito Júnior - Fadah Gattass - Francisco Dias - Geovah Amarante - Hélio Gueiros - Horácio Ferraz - Hu",
            "contextTags": [
              "html",
              "body",
              "p"
            ]
          },
          {
            "block": 3431,
            "anchors": [],
            "text": "In Memoriam: Alair Ferreira - Antônio Farias - Fábio Lucena - Norberto Schwantes - Virgílio Távora.",
            "contextTags": [
              "html",
              "body",
              "p"
            ]
          },
          {
            "block": 3432,
            "anchors": [],
            "text": "Este texto não substitui o publicado no D.O.U. de 5.10.1988 .",
            "contextTags": [
              "html",
              "body",
              "p"
            ]
          },
          {
            "block": 3433,
            "anchors": [
              "adct"
            ],
            "text": "ATO DAS DISPOSIÇÕES CONSTITUCIONAIS TRANSITÓRIAS",
            "contextTags": [
              "html",
              "body",
              "blockquote",
              "p"
            ]
          },
          {
            "block": 3434,
            "anchors": [],
            "text": "(Vide Emenda Constitucional nº 132, de 2023) Vigência",
            "contextTags": [
              "html",
              "body",
              "blockquote",
              "p"
            ]
          }
        ]
      }
    ],
    "correctedTransitions": [
